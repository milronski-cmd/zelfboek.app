{
  "expo": {
    "name": "Saldoplan",
    "slug": "saldoplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saldoplan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "nl.saldoplan.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Saldoplan gebruikt de camera om bonnen te fotograferen.",
        "NSPhotoLibraryUsageDescription": "Saldoplan gebruikt je foto's om bonnen te kiezen.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Saldoplan gebruikt de camera om bonnen te fotograferen.",
          "photosPermission": "Saldoplan gebruikt je foto's om bonnen te kiezen."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": false
    }
  }
}