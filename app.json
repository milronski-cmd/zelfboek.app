{
  "expo": {
    "name": "Saldoplan",
    "slug": "saldoplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saldoplan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "nl.saldoplan.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Saldoplan gebruikt de camera om bonnen te fotograferen.",
        "NSPhotoLibraryUsageDescription": "Saldoplan gebruikt je foto's om bonnen te kiezen.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1db1df",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Saldoplan gebruikt de camera om bonnen te fotograferen.",
          "photosPermission": "Saldoplan gebruikt je foto's om bonnen te kiezen."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b60f2a13-705d-4bf2-bd4a-bae52d846ed5"
      }
    },
    "owner": "danieldeskna"
  }
}
