generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Account en toegang ───────────────────────────

model Gebruiker {
  id              String         @id @default(cuid())
  email           String         @unique
  naam            String?
  aangemaakt      DateTime       @default(now())
  laatstActief    DateTime?
  totpGeheim      String? // versleuteld; tweestapsverificatie met een app
  totpAan         Boolean        @default(false)
  totpLaatsteStap Int? // laatst gebruikte tijdstap: dezelfde app-code werkt maar één keer
  geblokkeerd     Boolean        @default(false) // door een beheerder: niet meer inloggen, sessies weg
  geblokkeerdOm   String? // reden (alleen voor beheer)
  passkeys        Passkey[]
  sessies         Sessie[]
  codes           LoginCode[]
  lidmaatschappen Lidmaatschap[]
}

/// Inloggen met Face ID, vingerafdruk of Windows Hello (WebAuthn).
model Passkey {
  id             String    @id @default(cuid())
  gebruikerId    String
  gebruiker      Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  credentialId   String    @unique
  publicKey      String // base64url
  teller         Int       @default(0)
  naam           String?
  aangemaakt     DateTime  @default(now())
  laatstGebruikt DateTime?
}

model LoginCode {
  id          String    @id @default(cuid())
  gebruikerId String
  gebruiker   Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  codeHash    String
  verlooptOp  DateTime
  gebruiktOp  DateTime?
  pogingen    Int       @default(0)
  aangemaakt  DateTime  @default(now())
}

model Sessie {
  id                   String    @id @default(cuid())
  gebruikerId          String
  gebruiker            Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  tokenHash            String    @unique
  verlooptOp           DateTime
  aangemaakt           DateTime  @default(now())
  actieveOndernemingId String?
  /// Meekijken door een beheerder: e-mail van de beheerder. Zo'n sessie kan alleen kijken, niets wijzigen.
  meekijkerEmail       String?
  meekijkReden         String?
}

model Lidmaatschap {
  id            String      @id @default(cuid())
  gebruikerId   String
  gebruiker     Gebruiker   @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  rol           String      @default("eigenaar") // eigenaar | boekhouder | lezer

  @@unique([gebruikerId, ondernemingId])
}

// ─────────────────────────── Onderneming ───────────────────────────

model Onderneming {
  id                 String    @id @default(cuid())
  naam               String
  branche            String?
  rechtsvorm         String    @default("eenmanszaak")
  kvk                String?
  btwNummer          String?
  btwId              String? // NL...B01 btw-identificatienummer
  email              String?
  telefoon           String?
  iban               String?
  adres              String?
  postcode           String?
  plaats             String?
  land               String    @default("NL")
  logoPad            String?
  logo               Bytes?
  logoMime           String?
  website            String?
  startdatum         DateTime?
  btwTijdvak         String    @default("kwartaal") // maand | kwartaal | jaar
  korDeelnemer       Boolean   @default(false)
  whatsappNummer     String?   @unique // pas gezet na het koppelbericht vanaf dat nummer (zie inbound/whatsapp)
  nachtrunOp         DateTime? // laatste keer dat de dagelijkse taak deze onderneming deed (wie het langst wacht, gaat eerst)
  btwStelsel         String    @default("factuur") // factuur (btw over de factuurdatum, standaard) | kas (over ontvangen betalingen)
  urencriterium      Boolean   @default(true)
  starter            Boolean   @default(false) // startersaftrek
  factuurPrefix      String    @default("")
  factuurVolgnr      Int       @default(0)
  factuurJaar        Int? // jaar waar factuurVolgnr bij hoort
  offertePrefix      String    @default("OFF-")
  offerteVolgnr      Int       @default(0)
  offerteJaar        Int?
  betaaltermijn      Int       @default(14)
  factuurVoettekst   String?
  huisstijlKleur     String    @default("#1c1917")
  herinneringAuto    Boolean   @default(true)
  stripeKlantId      String?
  stripeAbonnementId String?
  abonnement         String    @default("proef") // proef | actief | achterstallig | gestopt
  proefTot           DateTime?
  zekerheidsgrens    Float     @default(0.85) // onder deze zekerheid vraagt Saldoplan het je
  herinneringTekst1  String? // eigen tekst voor de 1e herinnering (leeg = standaard)
  herinneringTekst2  String?
  herinneringTekst3  String?
  demoTot            DateTime? // demo-omgeving: verdwijnt na dit moment
  verwijscode        String?   @unique
  verwezenDoor       String? // verwijscode van wie deze klant aanbracht
  stripeStatus       String? // ruwe status uit Stripe (active, trialing, past_due, canceled, ...)
  maandBedragCent    Int? // wat dit abonnement per maand opbrengt volgens Stripe (jaarprijs / 12), voor MRR
  betaaldSinds       DateTime? // eerste keer dat Stripe "active" meldde (proef naar betaald)
  gestoptOp          DateTime? // wanneer het abonnement stopte
  aangemaakt         DateTime  @default(now())

  leden          Lidmaatschap[]
  bankrekeningen Bankrekening[]
  transacties    Transactie[]
  bonnen         Bon[]
  klanten        Klant[]
  facturen       Factuur[]
  offertes       Offerte[]
  terugkerend    TerugkerendeFactuur[]
  producten      Product[]
  uren           Urenregel[]
  kilometers     Kilometerregel[]
  activa         Activum[]
  koppelingen    Koppeling[]
  memoriaal      Memoriaalboeking[]
  aangiften      Aangifte[]
  meldingen      Melding[]
  gesprekken     Gesprek[]
  regels         Boekingsregel[]
  taken          Taak[]
  logboek        Logboek[]
}

/// Wie veranderde wat en wanneer (voor jezelf en je boekhouder).
model Logboek {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  wie           String? // e-mail of "Saldoplan"
  actie         String
  onderwerp     String?
  aangemaakt    DateTime    @default(now())

  @@index([ondernemingId, aangemaakt])
}

// ─────────────────────────── Bank ───────────────────────────

model Bankrekening {
  id            String       @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming  @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  naam          String
  iban          String
  bank          String? // ING, Rabobank, bunq, Knab, ...
  bron          String       @default("csv") // csv | mt940 | camt | psd2 | kanaal
  psd2SessieId  String?
  psd2AccountId String?
  psd2Verloopt  DateTime?
  laatsteSync   DateTime?
  saldo         Float?
  transacties   Transactie[]

  @@unique([ondernemingId, iban])
}

/// Een bankregel of uitbetaling van een verkoopkanaal. AI vult categorie, btwCode en zekerheid.
model Transactie {
  id             String        @id @default(cuid())
  ondernemingId  String
  onderneming    Onderneming   @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  bankrekeningId String?
  bankrekening   Bankrekening? @relation(fields: [bankrekeningId], references: [id])
  datum          DateTime
  bedrag         Float // positief = ontvangen, negatief = betaald
  tegenpartij    String
  tegenIban      String?
  omschrijving   String
  hash           String        @unique
  bron           String        @default("csv") // csv | mt940 | camt | psd2 | mollie | stripe | shopify | bol | woocommerce | paypal | import
  externId       String?
  categorie      String?
  grootboek      String? // RGS-code, bv. WOmzNopOlv
  btwCode        String? // 21 | 9 | 0 | vrijgesteld | geen | verlegd | eu_dienst | eu_goed | buiten_eu
  btwBedrag      Float?
  zakelijk       Boolean? // null = nog niet beoordeeld
  priveDeel      Float         @default(0) // 0..1, gemengd gebruik
  zekerheid      Float?
  uitleg         String?
  opmerking      String? // notitie van de ondernemer of boekhouder
  bevestigd      Boolean       @default(false)
  bonId          String?       @unique
  bon            Bon?          @relation(fields: [bonId], references: [id])
  factuurId      String?
  factuur        Factuur?      @relation(fields: [factuurId], references: [id])
  activumId      String?
  activum        Activum?      @relation(fields: [activumId], references: [id])
  aangemaakt     DateTime      @default(now())

  @@index([ondernemingId, datum])
  @@index([ondernemingId, zakelijk, bevestigd])
}

/// Geüploade bon of inkoopfactuur, door AI uitgelezen.
model Bon {
  id             String      @id @default(cuid())
  ondernemingId  String
  onderneming    Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  bestandsnaam   String
  mimeType       String
  bestandsPad    String
  inhoud         Bytes? // het bestand zelf (op Vercel is er geen schijf)
  bron           String      @default("upload") // upload | email | whatsapp
  leverancier    String?
  leverancierBtw String?
  factuurnummer  String?
  datum          DateTime?
  totaal         Float?
  btwBedrag      Float?
  btwCode        String?
  categorie      String?
  grootboek      String?
  valuta         String      @default("EUR")
  zekerheid      Float?
  uitleg         String?
  regelsJson     String? // uitgelezen regels
  status         String      @default("nieuw") // nieuw | uitgelezen | gekoppeld | fout | handmatig
  transactie     Transactie?
  aangemaakt     DateTime    @default(now())

  @@index([ondernemingId, status])
}

// ─────────────────────────── Verkoop ───────────────────────────

model Klant {
  id             String                @id @default(cuid())
  ondernemingId  String
  onderneming    Onderneming           @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  naam           String
  contactpersoon String?
  email          String?
  telefoon       String?
  adres          String?
  postcode       String?
  plaats         String?
  land           String                @default("NL")
  kvk            String?
  btwNummer      String?
  isOndernemer   Boolean               @default(true)
  betaaltermijn  Int?
  notities       String?
  taal           String                @default("nl") // nl | en | de: taal van facturen en herinneringen
  externId       String? // id bij Moneybird e.d.
  facturen       Factuur[]
  offertes       Offerte[]
  terugkerend    TerugkerendeFactuur[]
  uren           Urenregel[]
  aangemaakt     DateTime              @default(now())

  @@index([ondernemingId, naam])
}

model Product {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  naam          String
  omschrijving  String?
  prijs         Float
  btw           Float       @default(21)
  eenheid       String      @default("stuk") // stuk | uur | dag | km
}

model Factuur {
  id                 String               @id @default(cuid())
  ondernemingId      String
  onderneming        Onderneming          @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  klantId            String
  klant              Klant                @relation(fields: [klantId], references: [id])
  nummer             String
  soort              String               @default("factuur") // factuur | credit
  datum              DateTime             @default(now())
  vervaldatum        DateTime
  regels             String // JSON FactuurRegel[]
  subtotaal          Float
  btw                Float
  totaal             Float
  btwVerlegd         Boolean              @default(false)
  valuta             String               @default("EUR")
  referentie         String?
  opmerking          String?
  status             String               @default("concept") // concept | verzonden | herinnerd | aangemaand | betaald | oninbaar | gecrediteerd
  verzondenOp        DateTime?
  betaaldOp          DateTime?
  betaaldBedrag      Float                @default(0)
  herinneringen      Int                  @default(0)
  laatsteHerinnering DateTime?
  betaalLinkUrl      String?
  betaalLinkId       String? // Mollie payment id
  geopendOp          DateTime? // eerste keer dat de klant de factuur opende
  geopendKeer        Int                  @default(0)
  pdfPad             String?
  ublPad             String?
  gecrediteerdDoorId String?
  terugkerendId      String?
  terugkerend        TerugkerendeFactuur? @relation(fields: [terugkerendId], references: [id])
  offerteId          String?
  offerte            Offerte?             @relation(fields: [offerteId], references: [id])
  transacties        Transactie[]
  aangemaakt         DateTime             @default(now())

  @@unique([ondernemingId, nummer])
  @@index([ondernemingId, status])
}

model Offerte {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  klantId       String
  klant         Klant       @relation(fields: [klantId], references: [id])
  nummer        String
  datum         DateTime    @default(now())
  geldigTot     DateTime
  regels        String
  subtotaal     Float
  btw           Float
  totaal        Float
  opmerking     String?
  status        String      @default("concept") // concept | verzonden | geaccepteerd | afgewezen | verlopen | gefactureerd
  verzondenOp   DateTime?
  besluitOp     DateTime?
  acceptToken   String      @unique @default(cuid())
  handtekening  String? // getekende handtekening (PNG als data-URL)
  getekendDoor  String?
  getekendOp    DateTime?
  pdfPad        String?
  facturen      Factuur[]

  @@unique([ondernemingId, nummer])
}

model TerugkerendeFactuur {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  klantId       String
  klant         Klant       @relation(fields: [klantId], references: [id])
  omschrijving  String
  regels        String
  interval      String      @default("maand") // week | maand | kwartaal | jaar
  volgendeOp    DateTime
  eindigtOp     DateTime?
  autoVerzenden Boolean     @default(true)
  actief        Boolean     @default(true)
  facturen      Factuur[]
}

// ─────────────────────────── Fiscaal ───────────────────────────

model Urenregel {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  klantId       String?
  klant         Klant?      @relation(fields: [klantId], references: [id])
  datum         DateTime
  uren          Float
  omschrijving  String
  soort         String      @default("declarabel") // declarabel | indirect (acquisitie, administratie, studie)
  uurtarief     Float?
  gefactureerd  Boolean     @default(false)

  @@index([ondernemingId, datum])
}

model Kilometerregel {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  datum         DateTime
  van           String
  naar          String
  km            Float
  retour        Boolean     @default(false)
  doel          String
  vervoer       String      @default("prive_auto") // prive_auto | zakelijke_auto | fiets | ov
  vergoeding    Float // km * 0.23 bij privéauto

  @@index([ondernemingId, datum])
}

model Activum {
  id             String       @id @default(cuid())
  ondernemingId  String
  onderneming    Onderneming  @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  naam           String
  categorie      String       @default("inventaris") // inventaris | computer | auto | machine | verbouwing | overig
  aanschafDatum  DateTime
  aanschafBedrag Float // ex btw
  restwaarde     Float        @default(0)
  looptijdJaren  Int          @default(5)
  kiaToegepast   Boolean      @default(false)
  priveDeel      Float        @default(0)
  verkochtOp     DateTime?
  verkoopBedrag  Float?
  transacties    Transactie[]
}

/// Handmatige boeking buiten de bank om (privégebruik, correcties, afschrijving).
model Memoriaalboeking {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  datum         DateTime
  omschrijving  String
  bedrag        Float
  categorie     String
  grootboek     String?
  btwCode       String      @default("geen")
  btwBedrag     Float       @default(0)
  soort         String      @default("correctie") // correctie | afschrijving | prive_gebruik | beginbalans

  @@index([ondernemingId, datum])
}

/// Geboekte regels uit externe import (Moneybird e.d.) die niet uit de bank komen.
model Boekingsregel {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  datum         DateTime
  omschrijving  String
  bedrag        Float
  btwBedrag     Float       @default(0)
  categorie     String
  grootboek     String?
  bron          String
  externId      String?

  @@unique([ondernemingId, bron, externId])
}

model Aangifte {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  soort         String // btw | icp | ib
  jaar          Int
  periode       Int // kwartaal 1-4, maand 1-12, of 0 voor jaar
  rubrieken     String // JSON
  bedrag        Float
  status        String      @default("concept") // concept | klaar | ingediend | betaald
  ingediendOp   DateTime?
  betaaldOp     DateTime?
  xbrlPad       String?
  notitie       String?

  @@unique([ondernemingId, soort, jaar, periode])
}

// ─────────────────────────── Koppelingen ───────────────────────────

/// Verbinding met een externe dienst. Geheimen versleuteld opgeslagen.
model Koppeling {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  soort         String // enablebanking | mollie | stripe | shopify | bol | woocommerce | paypal | moneybird | eboekhouden | resend | whatsapp
  naam          String?
  configJson    String // versleuteld JSON met tokens en instellingen
  status        String      @default("actief") // actief | fout | verlopen | uitgeschakeld
  laatsteSync   DateTime?
  laatsteFout   String?
  aangemaakt    DateTime    @default(now())

  @@unique([ondernemingId, soort])
}

// ─────────────────────────── Overig ───────────────────────────

model Melding {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  soort         String // deadline | herinnering | sync | ai | systeem
  titel         String
  tekst         String
  link          String?
  gelezen       Boolean     @default(false)
  gemaild       Boolean     @default(false)
  aangemaakt    DateTime    @default(now())

  @@index([ondernemingId, gelezen])
}

model Taak {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  titel         String
  deadline      DateTime?
  klaar         Boolean     @default(false)
  bron          String      @default("ai") // ai | gebruiker | systeem
  aangemaakt    DateTime    @default(now())
}

/// Chatgesprek met de AI-assistent.
model Gesprek {
  id            String      @id @default(cuid())
  ondernemingId String
  onderneming   Onderneming @relation(fields: [ondernemingId], references: [id], onDelete: Cascade)
  titel         String?
  berichten     String // JSON MessageParam[]
  aangemaakt    DateTime    @default(now())
  bijgewerkt    DateTime    @updatedAt
}

model CronLog {
  id        String    @id @default(cuid())
  taak      String
  gestart   DateTime  @default(now())
  klaar     DateTime?
  resultaat String?
  fout      String?
}

/// Tellers voor limieten (inlogpogingen per IP, AI-gebruik per onderneming, demo's per IP). Ouder dan 2 dagen wordt opgeruimd.
model Poging {
  id         String   @id @default(cuid())
  sleutel    String
  aangemaakt DateTime @default(now())

  @@index([sleutel, aangemaakt])
}

/// Eenmalige berichten (webhook-betalingen, eenmalige links): een id dat hier staat is al verwerkt.
model Verwerkt {
  id         String   @id
  aangemaakt DateTime @default(now())
}

// ─────────────────────────── Beheer (Saldoplan zelf) ───────────────────────────

/// Wat beheerders deden (klant bekeken, proef verlengd, geblokkeerd, meegekeken). Blijft staan als de klant weg is.
model BeheerLog {
  id            String   @id @default(cuid())
  beheerder     String // e-mail van de beheerder
  actie         String
  gebruikerId   String?
  ondernemingId String?
  doel          String? // leesbaar: e-mail of naam van de klant op het moment van de actie
  reden         String?
  aangemaakt    DateTime @default(now())

  @@index([aangemaakt])
}

/// Feedback uit de app (knop "Feedback" op pc, telefoon en in de mobiele app).
model Feedback {
  id             String    @id @default(cuid())
  gebruikerId    String?
  ondernemingId  String?
  email          String?
  tekst          String
  pagina         String?
  toestel        String? // kort: "iPhone, Safari" of "Windows, Chrome" of "app iOS"
  bron           String    @default("web") // web | app
  schermafbeelding Bytes?
  schermMime     String?
  status         String    @default("nieuw") // nieuw | bekeken | opgelost
  notitie        String? // interne notitie van de beheerder
  aangemaakt     DateTime  @default(now())
  bijgewerkt     DateTime  @updatedAt

  @@index([status, aangemaakt])
}

/// AI-gebruik per onderneming per dag (voor kosten per klant en daglimiet). Tokens uit het antwoord van de AI.
model AiVerbruik {
  id            String   @id @default(cuid())
  ondernemingId String
  dag           DateTime // begin van de dag (UTC)
  verzoeken     Int      @default(0)
  invoerTokens  Int      @default(0)
  uitvoerTokens Int      @default(0)
  limietGeraakt Int      @default(0) // hoe vaak de daglimiet iemand tegenhield

  @@unique([ondernemingId, dag])
  @@index([dag])
}
